# Copy to .env.local and fill in. .env is gitignored — never commit real keys.

# Public site URL. Used for canonicals, sitemap, JSON-LD and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.devmations.com

# Resend — contact form delivery.
# Without RESEND_API_KEY the form returns a 503 telling the visitor to email directly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@devmations.com
# Until the sending domain is verified in Resend, leave this unset and the
# handler falls back to Resend's sandbox sender.
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile — bot protection on the contact form.
# Without TURNSTILE_SECRET_KEY the check is skipped and a warning is logged.
# The honeypot field still runs regardless.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
